# 复制为 .env 后修改。.env 已被 .gitignore 排除；密钥只留在这台电脑，绝不进入前端或备份。
# 项目在 Dropbox 里时，.env 要标记为不同步，否则密钥会上传到 Dropbox。见 README。

# AI 提供者：off（默认，AI 关闭）| gemini（云端，有免费额度）| ollama（本地模型）| anthropic（云端）
KITCHEN_AI_PROVIDER=off

# ── Gemini（只有 KITCHEN_AI_PROVIDER=gemini 时才会使用）──
# 免费版的数据可能被 Google 用于改进产品。密钥在 https://aistudio.google.com/apikey 创建。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── 本地模型（Ollama）────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 云端模型（只有 KITCHEN_AI_PROVIDER=anthropic 时才会使用）──
ANTHROPIC_API_KEY=
# 默认 claude-opus-5-5。这个场景只是解析一句话，想省钱可改成 claude-haiku-5-5。
ANTHROPIC_MODEL=claude-opus-5-5

# ── 辅助服务 ─────────────────────────────────────────
# 默认只监听本机。改成 0.0.0.0 暴露到局域网时，KITCHEN_HELPER_TOKEN 必须设置（至少 16 位），否则服务拒绝启动。
KITCHEN_HOST=127.0.0.1
KITCHEN_PORT=8787
# 配对口令。留空时每次启动随机生成并打印在终端（重启后手机要重新配对）。
KITCHEN_HELPER_TOKEN=
# 手机实际访问这台服务的 HTTPS 地址，用于生成配对链接，例如 Tailscale 的 https://你的电脑.tailnet名.ts.net
KITCHEN_PUBLIC_URL=
# PWA 不是由本服务托管时（例如放在 GitHub Pages），把它的来源写在这里，逗号分隔。
KITCHEN_ALLOWED_ORIGINS=
